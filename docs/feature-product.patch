+    <form class="admin-form" th:object="${form}"
+          th:action="${form.productId == null} ? @{/admin/products} : @{/admin/products/{id}(id=${form.productId})}"
+          method="post">
+        <div class="form-group">
+            <label class="form-label" for="categoryId">카테고리</label>
+            <select id="categoryId" class="form-control" th:field="*{categoryId}" required>
+                <option value="">선택</option>
+                <option th:each="category : ${adminCategories}"
+                        th:value="${category.categoryId}"
+                        th:text="${category.categoryName}">사료</option>
+            </select>
+            <p class="field-error" th:if="${#fields.hasErrors('categoryId')}" th:errors="*{categoryId}"></p>
