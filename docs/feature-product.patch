+            <option value="">전체 동물</option>
+            <option th:each="type : ${petTypes}"
+                    th:value="${type}"
+                    th:text="${type.label}"
+                    th:selected="${petType == type}"></option>
+        </select>
+        <button type="submit" class="btn btn-secondary">찾기</button>
+    </form>
+
+    <div class="table-wrap">
+        <table class="admin-table">
+            <thead>
+            <tr>
+                <th>상품</th>
+                <th>카테고리</th>
+                <th>가격</th>
+                <th>재고</th>
+                <th>구분</th>
+                <th>상태</th>
+                <th></th>
+            </tr>
+            </thead>
+            <tbody>
+            <tr th:each="product : ${result.content}">
+                <td th:text="${product.productName}">상품명</td>
+                <td th:text="${product.category.categoryName}">카테고리</td>
+                <td th:text="${#numbers.formatInteger(product.price, 0, 'COMMA')} + '원'">0원</td>
+                <td th:text="${product.stock}">0</td>
+                <td th:text="${product.petType.label}">공용</td>
+                <td th:text="${product.isActive} ? '판매중' : '비활성'">판매중</td>
+                <td class="admin-actions">
+                    <a th:href="@{/admin/products/{id}/edit(id=${product.productId})}">수정</a>
+                    <form th:action="@{/admin/products/{id}/deactivate(id=${product.productId})}" method="post">
+                        <button type="submit">비활성</button>
+                    </form>
+                    <form th:action="@{/admin/products/{id}/delete(id=${product.productId})}" method="post"
+                          onsubmit="return confirm('정말 삭제할까요?');">
+                        <button type="submit" class="danger">삭제</button>
+                    </form>
+                </td>
+            </tr>
+            </tbody>
+        </table>
+    </div>
+
+    <p class="empty-state" th:if="${result.totalElements == 0}">등록된 상품이 없습니다.</p>
+
+    <nav class="pager" th:if="${result.totalPages > 1}">
+        <a th:if="${result.hasPrevious()}"
+           class="btn btn-outline"
+           th:href="@{/admin/products(keyword=${keyword}, categoryId=${categoryId}, petType=${petType}, page=${result.number - 1})}">이전</a>
+        <span th:text="|${result.number + 1} / ${result.totalPages}|">1 / 1</span>
+        <a th:if="${result.hasNext()}"
+           class="btn btn-outline"
+           th:href="@{/admin/products(keyword=${keyword}, categoryId=${categoryId}, petType=${petType}, page=${result.number + 1})}">다음</a>
+    </nav>
+</main>
+
+<footer th:replace="~{fragments/footer :: footer}"></footer>
+</body>
+</html>
